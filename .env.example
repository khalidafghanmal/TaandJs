# -----------------------------------------------------------------------------
# Feature modules (optional — see docs/modules.md)
# -----------------------------------------------------------------------------
# TAAND_MODULES=true
# TAAND_MODULES_AUTO_ROUTES=true


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
TAAND_NAME=TaandJs
TAAND_ENV=local
TAAND_DEBUG=true
TAAND_APP_KEY=change-this-to-a-random-32-char-string
TAAND_APP_URL=http://127.0.0.1:2977


# -----------------------------------------------------------------------------
# Dev server
# -----------------------------------------------------------------------------
TAAND_HOST=127.0.0.1
TAAND_PORT=2977
TAAND_FALLBACK_PORT=1893
TAAND_OPEN_BROWSER=true
TAAND_VIEW_CACHE=true
TAAND_HOT_RELOAD=true


# -----------------------------------------------------------------------------
# Production server (npm run build && npm run start)
# -----------------------------------------------------------------------------
TAAND_SERVER_PORT=8000
TAAND_SERVER_TIMEOUT=30000
TAAND_SHUTDOWN_TIMEOUT=30000
TAAND_HEALTH_PATH=/up


# -----------------------------------------------------------------------------
# Database — PostgreSQL (default)
# -----------------------------------------------------------------------------
# Local: npm run docker:up  →  starts Postgres + Redis (see docs/docker.md)
# Neon:  use pooled URL for DATABASE_URL, direct URL for DIRECT_URL
DB_CONNECTION=postgresql
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/taand?schema=public"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5432/taand?schema=public"

# MySQL (alternative — set provider = "mysql" in schema/schema.prisma, remove directUrl)
# DB_CONNECTION=mysql
# DATABASE_URL="mysql://root:password@127.0.0.1:3306/taand"


# -----------------------------------------------------------------------------
# Cache & sessions
# -----------------------------------------------------------------------------
TAAND_CACHE_STORE=memory
TAAND_CACHE_PREFIX=
TAAND_CACHE_MAX_ENTRIES=1000
TAAND_CACHE_MAX_BYTES=52428800

# Redis (npm run docker:up) — uncomment to use across processes
REDIS_URL=redis://127.0.0.1:6379
# TAAND_CACHE_STORE=redis
# SESSION_DRIVER=redis


# -----------------------------------------------------------------------------
# Queue
# -----------------------------------------------------------------------------
QUEUE_CONNECTION=sync
QUEUE_RETRY_AFTER=90
# QUEUE_CONNECTION=redis


# -----------------------------------------------------------------------------
# Mail
# -----------------------------------------------------------------------------
MAIL_MAILER=array
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=TaandJs
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SECURE=false
MAIL_RATE_LIMIT=60


# -----------------------------------------------------------------------------
# Authentication & API tokens
# -----------------------------------------------------------------------------
TAAND_API_TOKEN=
# Comma-separated abilities for TAAND_API_TOKEN (default *). Use explicit scopes in production.
TAAND_MACHINE_ABILITIES=*
# Allow TAAND_API_TOKEN in production (blocked by default — prefer personal access tokens)
TAAND_ALLOW_MACHINE_TOKEN=false
TAAND_TOKEN_PREFIX=
TAAND_TOKEN_EXPIRATION_DAYS=0


# -----------------------------------------------------------------------------
# Security (proxy trust, dev dashboards)
# -----------------------------------------------------------------------------
# Comma-separated IPs of reverse proxies that may set X-Forwarded-For (e.g. 127.0.0.1,10.0.0.1)
TAAND_TRUSTED_PROXIES=
# Optional secret for /__Taand/* dev dashboards (query dashboard_key or header X-taand-Dev-Key)
TAAND_DEV_DASHBOARD_KEY=


# -----------------------------------------------------------------------------
# Logging & events
# -----------------------------------------------------------------------------
TAAND_LOG_LEVEL=debug
TAAND_LOG_CHANNEL=stack
TAAND_LOG_DAYS=14
TAAND_EVENT_MAX_LISTENERS=100
TAAND_EVENT_STOP_ON_FAILURE=false


# -----------------------------------------------------------------------------
# CORS (SPA / API on another origin — see docs/cors.md)
# -----------------------------------------------------------------------------
CORS_ENABLED=true
# Use explicit origins when CORS_SUPPORTS_CREDENTIALS=true (never combine with *)
CORS_ALLOWED_ORIGINS=*
CORS_SUPPORTS_CREDENTIALS=false
CORS_MAX_AGE=0


# -----------------------------------------------------------------------------
# Assets & storage
# -----------------------------------------------------------------------------
TAAND_ASSET_URL=
TAAND_ASSET_VERSION=
FILESYSTEM_DISK=local

# S3 / cloud storage (production uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
